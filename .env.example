# Etsy API credentials — get from https://www.etsy.com/developers/your-apps
ETSY_KEYSTRING=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# Populated by bootstrap_oauth.py — paste the printed shop_id here after running it
ETSY_SHOP_ID=

# Optional
ETSY_LOG_LEVEL=INFO
ETSY_OAUTH_REDIRECT_PORT=3003

# Browser automation (Phase 1c). Set to 1 to launch a visible browser
# instead of headless — useful for debugging when selectors break.
ETSY_ADS_HEADFUL=0

# Shop timezone — used to interpret "YYYY-MM-DD" date inputs in revenue/exports
# reports and to bucket receipts by local day. Default: America/Denver
# (Mountain Time, with DST). Use America/Phoenix for strict MST (Arizona, no DST).
# Set this to your shop's home timezone for correct daily reporting.
ETSY_SHOP_TIMEZONE=America/Denver

# Optional OAuth redirect URI override. Default: http://localhost:$PORT/callback.
# Set this when Etsy rejects localhost URIs and you need a public tunnel
# (e.g. https://<random>.trycloudflare.com/callback).
# ETSY_OAUTH_REDIRECT_URI=
